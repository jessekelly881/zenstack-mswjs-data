{
  "name": "zenstack-msw-data",
  "displayName": "Zenstack MSW Factory Generator",
  "version": "0.0.6",
  "description": "Generate MSW Data factories from ZenStack",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jessekelly881/zenstack-mswjs-data"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": true
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run lint && npm run clean && tsc && copyfiles ./package.json ./README.md ./README-1.svg ./README-2.svg ./LICENSE ./static/* dist",
    "dev": "zenstack generate --output codegen --no-compile",
    "watch": "tsc --watch",
    "lint": "eslint src",
    "check": "tsc --project tsconfig.json --noEmit --downlevelIteration",
    "test": "ts-node test.ts"
  },
  "author": "Jesse Kelly",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.41",
    "@ai-sdk/openai": "^2.0.62",
    "@ai-sdk/xai": "^2.0.31",
    "@changesets/cli": "^2.27.11",
    "@effect/platform": "^0.92.1",
    "@effect/platform-node": "^0.98.4",
    "@prisma/generator-helper": "^6.2.1",
    "@zenstackhq/runtime": "^2.10.0",
    "@zenstackhq/sdk": "^2.10.0",
    "ai": "^5.0.87",
    "dotenv": "^17.2.3",
    "effect": "^3.12.1",
    "typescript": "^5.7.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.19.0",
    "@faker-js/faker": "^10.1.0",
    "@mswjs/data": "^0.16.2",
    "@prisma/client": "^6.2.1",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "copyfiles": "^2.4.1",
    "cpx": "^1.5.0",
    "eslint": "^9.19.0",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.1",
    "zenstack": "^2.10.0"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
